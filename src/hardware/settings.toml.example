# Copy to src/hardware/settings.toml and fill in your values; deploy.sh copies
# it to the CIRCUITPY drive. CircuitPython reads these with os.getenv() -- no
# secrets.py needed.
#
# The desktop simulator reads the same file (or `run.py --settings PATH`).
# Without the file or HA_URL it shows fake sensor values instead.
# settings.toml holds your token, so it is git-ignored.

# WiFi (hardware only)
CIRCUITPY_WIFI_SSID = "your-wifi-ssid"
CIRCUITPY_WIFI_PASSWORD = "your-wifi-password"

# Home Assistant on your LAN (no cloud needed). A hostname is resolved once at startup.
# An IP is the safest choice: mDNS names like homeassistant.local often don't resolve
# on WSL2 or CircuitPython. Plain http only.
HA_URL = "http://192.1.1.1:8123"
# Long-lived access token: HA -> your profile -> Security -> Long-lived access tokens
HA_TOKEN = "paste-token-here"

# Entity IDs for the sensor readout (adjust to your actual entities)
HA_CO2_ENTITY = "sensor.living_room_co2"
HA_TEMPERATURE_ENTITY = "sensor.living_room_temperature"
HA_HUMIDITY_ENTITY = "sensor.living_room_humidity"

# Seconds between reads, 1-60 (clamped; default 5)
HA_POLL_SECONDS = 5

# Minimum seconds between saves of the menu settings and the pond to
# microcontroller.nvm on the board / state.json on the desktop. 10-3600
# (clamped; default 60). Saves only happen when something changed.
PERSIST_SECONDS = 60

# Debug only: multiplies the pond's clock, so fish age, breed and die in
# minutes instead of days. 3600 makes a pond hour pass every second (a koi
# lives ~3 minutes). 1-86400 (clamped; default 1).
# POND_TIME_SCALE = 3600

# Pond effects (all optional; an unset entity just leaves its effect out).
# Smart plug power sensors, in W: while the washer draws more than
# WASHER_ON_WATTS an electric eel visits the pond, and while the 3D printer
# draws more than PRINTER_ON_WATTS a lily pad with a printer on it drifts by.
# 1-500 (clamped; default 10).
HA_WASHER_POWER_ENTITY = "sensor.washer_power"
# WASHER_ON_WATTS = 10
HA_PRINTER_POWER_ENTITY = "sensor.printer_plug_power"
# PRINTER_ON_WATTS = 10

# A helper summing the house's power, in W. Sparks jump between the boids,
# none at or below ZAP_MIN_WATTS (0-20000, default 300) and most often at or
# above ZAP_MAX_WATTS (100-50000, default 5000; raised to min + 100 if not above it).
HA_TOTAL_POWER_ENTITY = "sensor.house_power"
# ZAP_MIN_WATTS = 300
# ZAP_MAX_WATTS = 5000

# An input_boolean helper: "off" puts the panel to sleep, anything else shows it
HA_DISPLAY_ENTITY = "input_boolean.pond_display"
